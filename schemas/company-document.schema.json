{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iranopenprivacy.org/schemas/company-document.schema.json",
  "title": "IOP company privacy document front matter",
  "type": "object",
  "required": [
    "schema_version", "company", "slug", "domain", "language",
    "document_version", "previous_version", "effective_date",
    "change_type", "change_note", "data", "contact"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "company": { "type": "string", "minLength": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
    "language": { "enum": ["fa", "en"] },
    "license": { "type": "string", "default": "CC-BY-4.0" },
    "document_version": { "$ref": "#/$defs/semver" },
    "previous_version": { "oneOf": [{ "$ref": "#/$defs/semver" }, { "type": "null" }] },
    "effective_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "change_type": { "enum": ["initial", "patch", "minor", "major"] },
    "change_note": { "type": "string", "minLength": 5 },
    "data": {
      "type": "object",
      "required": ["collected", "third_parties", "data_location", "sells_or_shares_for_ads"],
      "additionalProperties": false,
      "properties": {
        "collected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["category", "purpose", "retention"],
            "additionalProperties": false,
            "properties": {
              "category": { "type": "string" },
              "purpose": { "type": "string" },
              "basis": { "type": "string" },
              "retention": { "type": "string" },
              "sensitive": { "type": "boolean" }
            }
          }
        },
        "third_parties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "purpose", "country"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "country": { "type": "string" }
            }
          }
        },
        "data_location": { "type": "string", "minLength": 2 },
        "sells_or_shares_for_ads": { "type": "boolean" }
      }
    },
    "contact": {
      "type": "object",
      "required": ["privacy_owner", "email"],
      "additionalProperties": false,
      "properties": {
        "privacy_owner": { "type": "string" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
